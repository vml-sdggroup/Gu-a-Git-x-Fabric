	/// Tabla de fechas generada con la función DAX CALENDAR().
	/// Abarca desde la fecha mínima hasta la máxima de FactSales[Date].
	/// Columnas derivadas: Year, MonthNr, Month, DayNr, Day, QuarterNr, YearMonth, YearMonthSort, DateID.
	/// Marcada como tabla de tiempo (dataCategory: Time).
	partition Calendar = calculated
		mode: import
		source = CALENDAR(MIN(FactSales[Date]),MAX(FactSales[Date]))

	annotation PBI_Id = 4713aa8c282b464299809184407b4f4c

