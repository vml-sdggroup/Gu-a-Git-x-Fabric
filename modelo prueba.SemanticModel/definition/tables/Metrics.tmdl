table Metrics
	lineageTag: a9b1e37a-8892-4f00-a0b6-11b6cebe442b

	measure Total_Net_Sales = SUM(FactSales[Sale])
		formatString: #,0.###############\ "€";-#,0.###############\ "€";#,0.###############\ "€"
		lineageTag: 961d4c6f-aef7-405d-8f4a-77fa9a3b93b9

		annotation PBI_FormatHint = {"currencyCulture":"es-ES"}

	measure TotalUnits = SUM(FactSales[Unit])
		formatString: 0
		lineageTag: e467f0fe-193e-4c4a-b8d8-61e7ed255b69

	measure TotalIssues =
			
			CALCULATE(
			    COUNTROWS(FactSales),
			    KEEPFILTERS(FactSales[Issue] <> "None")
			)
		formatString: 0
		lineageTag: 00de0ed5-cf19-482b-b26b-63d37663bbf2

	measure TotalSalesWithPromotion = CALCULATE(SUM(FactSales[Sale]), FactSales[Promotion] <> "None")
		formatString: #,0.###############\ "€";-#,0.###############\ "€";#,0.###############\ "€"
		lineageTag: bb887b54-7fe6-4519-98ee-78b382a4a648

		annotation PBI_FormatHint = {"currencyCulture":"es-ES"}

	measure TotalAmountDiscounted =
			
			SUMX(
			    FactSales,
			    FactSales[Amount] * FactSales[AmountPromotion]
			)
		formatString: #,0.###############\ "€";-#,0.###############\ "€";#,0.###############\ "€"
		lineageTag: 7dbf7501-0b9e-4d3b-8f64-a9933a0173aa

		annotation PBI_FormatHint = {"currencyCulture":"es-ES"}

	measure TransactionsNumber = DISTINCTCOUNT(FactSales[SalesID])
		formatString: 0
		lineageTag: 2a119eff-c9df-4fd9-8ff2-796dbf8ca6d8

	measure IssuesRatio =
			
			DIVIDE(
			    [TotalIssues],
			    [TransactionsNumber],0
			)
		lineageTag: bb2772e4-e14b-49c5-8b4b-e65c123f738f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Ratio_Sales_Discounted =
			
			DIVIDE(
			    [TotalAmountDiscounted],
			    [Total_Net_Sales] + [TotalAmountDiscounted],
			    0
			)
		lineageTag: 5a098d7d-2480-4c28-aa97-3bdacc6ede60

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure AVG_Sale_Amount =
			
			DIVIDE(
			    [Total_Net_Sales],
			    [TransactionsNumber],
			    0
			)
		formatString: #,0.###############\ "€";-#,0.###############\ "€";#,0.###############\ "€"
		lineageTag: 8ea77e37-2c0f-4dd4-b99a-720fb0d9d87e

		annotation PBI_FormatHint = {"currencyCulture":"es-ES"}

	measure 'Total Net Sales PY' =
			
			CALCULATE(
			    SUM(FactSales[Sale]),
			    SAMEPERIODLASTYEAR('Calendar'[Date])
			) + 0
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 76359641-7d79-4ecd-a0c2-736590a34f12

	measure 'Issues with promo' =
			
			CALCULATE(
			    Metrics[TotalIssues],
			    FactSales[Promotion] <> "None"
			)
		lineageTag: 8c9021ce-d0df-4e42-9ec8-ed0dad6285ec

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Issues wit no promo' =
			
			CALCULATE(
			    Metrics[TotalIssues],
			    FactSales[Promotion] = "None"
			)
		lineageTag: 76e9a0cc-8ef8-4b64-b3c2-5498eac44cbd

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure TotalIssuesLY =
			
			CALCULATE(
			    [TotalIssues],
			    SAMEPERIODLASTYEAR(('Calendar'[Date])
			))
		formatString: 0
		lineageTag: 791ebaaa-9d1b-42e2-8e69-ef5e284bf442

	measure %DiffIssuesLY =
			
			IF(
			    NOT ISBLANK([TotalSalesLY]),
			    DIVIDE(
			        [DiffIssuesLY],
			        [TotalIssuesLY]),
			    0
			)
		lineageTag: 35560aed-ba86-49bd-bccc-b32e44cde60b

	measure DiffIssuesLY =
			
			// Primero, comprobamos si hay ventas en el periodo actual para evitar cálculos innecesarios
			IF(
			    NOT ISBLANK([TotalIssues]),
			    // Segundo, y más importante, comprobamos si el contexto tiene un periodo de tiempo válido para comparar
			    // Esto oculta el valor en la fila "Total"
			    IF(
			        NOT ISBLANK([TotalIssuesLY]),
			        [TotalIssues] - [TotalIssuesLY],
			        "N/A"
			    )
			)
		lineageTag: 4807adca-3117-40e7-8f97-f210a57e8a85

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure TotalSalesLY =
			
			CALCULATE(
			    [Total_Net_Sales],
			    PREVIOUSYEAR('Calendar'[Date])
			)
		formatString: #,0.###############\ "€";-#,0.###############\ "€";#,0.###############\ "€"
		lineageTag: cf55e4ad-e7f1-4580-a6cb-fc3767b56e23

		annotation PBI_FormatHint = {"currencyCulture":"es-ES"}

	measure %DiffSalesLY =
			
			IF(
			    NOT ISBLANK([TotalSalesLY]),
			    DIVIDE(
			        [DiffSalesLY],
			        [TotalSalesLY]),
			    0
			)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 3a925547-8af1-48c5-bd41-86d7b8c218ca

	measure %TotalIssues =
			
			DIVIDE(
			    [TotalIssues],
			    CALCULATE(
			        [TotalIssues],
			        ALLSELECTED(Products)
			    )
			)
		lineageTag: a3b9e3fc-e375-4989-b8f9-663e643c4fb9

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure %TotalSales = ```
			
			DIVIDE(
			    [Total_Net_Sales],
			    CALCULATE(
			        [Total_Net_Sales],
			        ALLSELECTED(Products) 
			    )
			)
			```
		lineageTag: 99e39e9d-5115-4999-83b4-1f8b4881a504

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure DiffSalesLY =
			
			// Primero, comprobamos si hay ventas en el periodo actual para evitar cálculos innecesarios
			IF(
			    NOT ISBLANK([Total_Net_Sales]),
			    // Segundo, y más importante, comprobamos si el contexto tiene un periodo de tiempo válido para comparar
			    // Esto oculta el valor en la fila "Total"
			    IF(
			        NOT ISBLANK([TotalSalesLY]),
			        [Total_Net_Sales] - [TotalSalesLY],
			        "N/A"
			    )
			)
		lineageTag: ad8395cc-614e-4893-87bf-b34ba1572062

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '%Sales per gender' =
			
			DIVIDE(
			    [Total_Net_Sales],
			    CALCULATE(
			        [Total_Net_Sales],
			        ALL(FactSales[Gender])
			    )
			)
		lineageTag: 5c834531-33e4-44f8-baf7-10e3c99034aa

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'medida prueba dev' = sum(FactSales[Amount])
		formatString: #,0.###############\ "€";-#,0.###############\ "€";#,0.###############\ "€"
		lineageTag: a0e496af-0d5a-4fe6-9ec1-70a90811d9ef

		annotation PBI_FormatHint = {"currencyCulture":"es-ES"}

	measure total_amount = SUM(FactSales[Amount])
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 09b39aba-b7c0-4d7f-8c2c-98109296a98e

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	column Column
		formatString: 0
		lineageTag: a7dd72f9-7e06-416c-934a-4241f424c74f
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Column]

		annotation SummarizationSetBy = Automatic

	partition Metrics = calculated
		mode: import
		source = Row("Column", BLANK())

	annotation PBI_Id = 0abd3239f17d46e78d34626a692cdfdc

	annotation 436ba87b-9c83-4389-a31b-ebd06a36be98 = {"Expression":""}

