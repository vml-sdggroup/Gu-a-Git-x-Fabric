expression fnCrearCalendario =
		(StartDate as date, EndDate as date) =>
		let
		    // Lista de nombres de mes y día en español
		    ListaMeses = {"Enero", "Febrero", "Marzo", "Abril", "Mayo", "Junio", "Julio", "Agosto", "Septiembre", "Octubre", "Noviembre", "Diciembre"},
		    ListaDias = {"Lunes", "Martes", "Miércoles", "Jueves", "Viernes", "Sábado", "Domingo"},
		
		    // Generar la lista de fechas
		    NumeroDeDias = Duration.Days(EndDate - StartDate) + 1,
		    ListaFechas = List.Dates(StartDate, NumeroDeDias, #duration(1, 0, 0, 0)),
		
		    // Convertir la lista a tabla
		    TablaDesdeLista = Table.FromList(ListaFechas, Splitter.SplitByNothing(), null, null, ExtraValues.Error),
		    TablaRenombrada = Table.RenameColumns(TablaDesdeLista, {{"Column1", "Fecha"}}),
		    TipoCambiado = Table.TransformColumnTypes(TablaRenombrada, {{"Fecha", type date}}),
		
		    // --- Añadir Columnas de Calendario ---
		    Año = Table.AddColumn(TipoCambiado, "Año", each Date.Year([Fecha]), Int64.Type),
		    TrimestreNro = Table.AddColumn(Año, "TrimestreNro", each Date.QuarterOfYear([Fecha]), Int64.Type),
		    MesNro = Table.AddColumn(TrimestreNro, "MesNro", each Date.Month([Fecha]), Int64.Type),
		    MesNombre = Table.AddColumn(MesNro, "MesNombre", each ListaMeses{[MesNro]-1}, type text),
		    DiaDelMes = Table.AddColumn(MesNombre, "DiaDelMes", each Date.Day([Fecha]), Int64.Type),
		    SemanaDelAño = Table.AddColumn(DiaDelMes, "SemanaDelAño", each Date.WeekOfYear([Fecha], Day.Monday), Int64.Type),
		    DiaDeLaSemana = Table.AddColumn(SemanaDelAño, "DiaDeLaSemana", each Date.DayOfWeek([Fecha], Day.Monday), Int64.Type), // Lunes=0, Martes=1...
		    NombreDia = Table.AddColumn(DiaDeLaSemana, "NombreDia", each ListaDias{[DiaDeLaSemana]}, type text),
		    InicioDeMes = Table.AddColumn(NombreDia, "InicioDeMes", each Date.StartOfMonth([Fecha]), type date),
		    FinDeMes = Table.AddColumn(InicioDeMes, "FinDeMes", each Date.EndOfMonth([Fecha]), type date),
		    InicioDeSemana = Table.AddColumn(FinDeMes, "InicioDeSemana", each Date.StartOfWeek([Fecha], Day.Monday), type date),
		    AñoMes = Table.AddColumn(InicioDeSemana, "AñoMesSort", each ([Año] * 100) + [MesNro], Int64.Type) // Columna para ordenar Año-Mes
		in
		    AñoMes
	lineageTag: daf0b28e-45f2-4d9f-bbd3-2537495c127d

	annotation PBI_NavigationStepName = Navegación

	annotation PBI_ResultType = Function

expression Calendario =
		let
		    // 1. Obtener la fecha mínima y máxima de tu tabla de hechos
		    //    Reemplaza "NombreDeTuTablaDeHechos" y "[NombreDeTuColumnaDeFecha]"
		    FechaMinima = List.Min(FactSales[Date]),
		    FechaMaxima = List.Max(FactSales[Date]),
		
		    // 2. Llamar a la función que creaste en el paso anterior
		    TablaCalendario = fnCrearCalendario(FechaMinima, FechaMaxima),
		    #"Columnas quitadas" = Table.RemoveColumns(TablaCalendario,{"SemanaDelAño", "DiaDeLaSemana", "NombreDia", "InicioDeMes", "FinDeMes", "InicioDeSemana"})
		in
		    #"Columnas quitadas"
	lineageTag: 345c55b1-2e8b-45f5-904e-b35d6f355d76

